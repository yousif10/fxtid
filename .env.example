# ---------------------------------------------------------------------------
# FXT Employee ID Card System - environment variables
#
# Copy to .env.local for local development, or set these in Vercel
# (Project → Settings → Environment Variables) separately for the Production
# and Preview environments. NEVER commit real values.
#
# All variables are SERVER-ONLY. There are deliberately no NEXT_PUBLIC_*
# variables: nothing here is ever sent to the browser.
# ---------------------------------------------------------------------------

# Public base URL (no trailing slash). Printed into every QR code, so it must
# be the final domain before any card is printed.
#   Production: https://id.fxt-ltd.co.uk
#   Preview:    leave unset (the preview's own *.vercel.app URL is used)
APP_URL=https://id.fxt-ltd.co.uk

# Which data set this deployment may touch: production | preview | development.
# Vercel Production MUST be "production"; Vercel Preview MUST NOT be. The app
# refuses to start if a preview is wired to production data or the production domain.
FXT_DATA_ENVIRONMENT=production

# --- Database (Supabase PostgreSQL) ------------------------------------------
# Runtime connection used by the app on Vercel: the Supabase TRANSACTION pooler
# (Supavisor, port 6543). Dashboard → Connect → "Transaction pooler".
DATABASE_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
# Migrations/admin scripts: DIRECT connection or SESSION pooler (port 5432).
# Only needed where you run `pnpm db:migrate` - do not set it in Vercel.
DATABASE_MIGRATION_URL=postgres://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Supabase requires TLS.
DATABASE_SSL=require
# Connections per serverless instance (default 3 on Vercel, 10 elsewhere).
# DB_POOL_MAX=3

# --- Photo storage -------------------------------------------------------------
# "supabase" (private Supabase Storage bucket; required on Vercel) or
# "local" (development / self-hosted Docker volume).
STORAGE_DRIVER=supabase
# Supabase project URL (server-only - do NOT prefix with NEXT_PUBLIC_).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase SECRET key (sb_secret_…) or legacy service_role key. Server-only.
# It bypasses Storage RLS so it must never reach the browser or be committed.
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
# Private bucket name (created by `pnpm storage:setup`).
SUPABASE_STORAGE_BUCKET=employee-photos
# Local driver only:
# STORAGE_DIR=./storage

# --- Sessions --------------------------------------------------------------------
# Admin session lifetime in hours (sliding).
SESSION_TTL_HOURS=12
# Client IPs from X-Forwarded-For: automatic on Vercel. Set "true" only behind a
# reverse proxy you control (Coolify, Dokploy, Nginx, Traefik).
# TRUST_PROXY=true

# --- Local development only ---------------------------------------------------------
# With no DATABASE_URL (and outside Vercel/production) an embedded PGlite database
# is stored here. Never used in deployed environments.
# PGLITE_DIR=./.data/pglite
# `pnpm db:seed` can create a development super admin (refused for production):
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
