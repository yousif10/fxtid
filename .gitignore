# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- build output ----
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# ---- environment files & secrets (only the placeholder example is committed) ----
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# ---- local data: databases, uploads, employee photographs, backups ----
/.data
/storage
/uploads
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.backup
/backups

# ---- generated exports & private test artifacts ----
/exports
*.pdf
*-dpi.png
/test-results
/playwright-report
/coverage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- tooling / OS ----
.vercel
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
/.claude/settings.local.json
